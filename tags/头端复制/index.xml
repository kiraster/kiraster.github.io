&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">Bandwidth: 64 kbps
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">Maximum transmission unit: 1464
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">Internet protocol processing: Disabled
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">Last clearing of counters: Never
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">Tunnel source 1.1.1.1, destination 2.2.2.2
