&lt;h2 id="清除tag">清除tag
&lt;/h2>&lt;p>查看本地tag和远程tag&lt;/p>
&lt;div class="highlight">&lt;pre tabindex="0" class="chroma">&lt;code class="language-fallback" data-lang="fallback">&lt;span class="line">&lt;span class="cl">git tag -l # 查看本地标签
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">git ls-remote --tags origin # 查看远程标签
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h3 id="删除本地标签">删除本地标签
&lt;/h3>&lt;p>删除单个标签&lt;/p>
&lt;div class="highlight">&lt;pre tabindex="0" class="chroma">&lt;code class="language-fallback" data-lang="fallback">&lt;span class="line">&lt;span class="cl">git tag -d v1.0.0 # 删除本地名为 v1.0.0 的标签
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h3 id="删除所有本地标签">删除所有本地标签
&lt;/h3>&lt;div class="highlight">&lt;pre tabindex="0" class="chroma">&lt;code class="language-fallback" data-lang="fallback">&lt;span class="line">&lt;span class="cl">git tag -l | xargs git tag -d # 批量删除所有本地标签
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h3 id="删除远程仓库标签">删除远程仓库标签
&lt;/h3>&lt;p>删除单个远程标签&lt;/p>
&lt;div class="highlight">&lt;pre tabindex="0" class="chroma">&lt;code class="language-fallback" data-lang="fallback">&lt;span class="line">&lt;span class="cl">git push origin --delete v1.0.0 # 删除远程标签
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h3 id="删除所有远程标签">删除所有远程标签
&lt;/h3>&lt;div class="highlight">&lt;pre tabindex="0" class="chroma">&lt;code class="language-fallback" data-lang="fallback">&lt;span class="line">&lt;span class="cl">git ls-remote --tags origin | awk &amp;#39;{print $2}&amp;#39; | xargs git push origin --delete
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h2 id="最后">最后
